+/** Explicit scripted model/DAO fixtures. Real MySQL integration is tested separately over HTTP. */
+public class FollowUpFailureTest {
+ private LlmFollowUpProvider parser(final String output,final boolean fail) throws Exception {
+  LlmFollowUpProvider provider=new LlmFollowUpProvider("fixture","","","",500);
+  OpenAiCompatibleProvider stub=new OpenAiCompatibleProvider("fixture","","","",500){
+   @Override public boolean available(){return true;}
+   @Override public String providerName(){return "scripted fixture";}
+   @Override public String model(){return "fixture-no-model";}
+   @Override public String complete(String system,String input){if(fail)throw new AiProviderException("Synthetic timeout");return output;}
+  };
+  Field field=LlmFollowUpProvider.class.getDeclaredField("ai");field.setAccessible(true);field.set(provider,stub);return provider;
+ }
+ @Test public void brokenJsonDegrades() throws Exception {assertEquals("INVALID_MODEL_OUTPUT",parser("not-json",false).decide("食堂","改善","食堂不方便").reason);}
+ @Test public void fabricatedEvidenceDegrades() throws Exception {assertEquals("INVALID_MODEL_OUTPUT",parser("{\"action\":\"EXPLORE\",\"reasonCode\":\"SELF_RAISED_CUE\",\"quote\":\"虚构朋友\"}",false).decide("食堂","改善","食堂不方便").reason);}
+ @Test public void providerTimeoutDegrades() throws Exception {assertEquals("MODEL_FAILURE",parser("",true).decide("食堂","改善","食堂不方便").reason);}
+ @Test public void skipCannotExposeAnUnverifiedModelQuote() throws Exception {assertEquals("",parser("{\"action\":\"SKIP\",\"reasonCode\":\"SUFFICIENT\",\"quote\":\"虚构证据\"}",false).decide("食堂","改善","食堂不方便").quote);}
+ @Test public void validModelClassificationProducesVerifiableNeutralQuestion() throws Exception {FollowUpDecisionProvider.Proposal p=parser("{\"action\":\"CLARIFY\",\"reasonCode\":\"AMBIGUOUS\",\"quote\":\"食堂不方便\"}",false).decide("食堂","改善","食堂不方便");assertEquals("CLARIFY",p.action);assertTrue(RuleFollowUpProvider.neutralQuestion(p,"食堂不方便").contains("食堂不方便"));}
+
+ private FollowUpDecision exercise(String reason,boolean consent) {
+  FollowUpMapper db=mock(FollowUpMapper.class);UserFormService forms=mock(UserFormService.class);UserFormVersionService versions=mock(UserFormVersionService.class);
+  LlmFollowUpProvider llm=mock(LlmFollowUpProvider.class);PlatformTransactionManager tx=mock(PlatformTransactionManager.class);
+  when(tx.getTransaction(any())).thenReturn(new SimpleTransactionStatus());
+  Map<String,Object> session=new HashMap<>();session.put("id","session1");session.put("formKey","form1");session.put("versionNo",1);session.put("consent",consent);session.put("used",0);session.put("status","ACTIVE");session.put("createdAt",System.currentTimeMillis());session.put("expiresAt",System.currentTimeMillis()+600000);
+  session.put("policyJson","{\"totalBudget\":2,\"perQuestionBudget\":1,\"timeBudgetSeconds\":600,\"mode\":\"LLM\",\"goal\":\"食堂改善\",\"allowedQuestionIds\":[\"q1\"]}");
+  when(db.byCapability(anyString())).thenReturn(session);when(db.lock("session1")).thenReturn(session);when(db.decisions("session1")).thenReturn(Collections.emptyList());
+  when(db.source("session1","q1")).thenReturn(null);
+  UserFormEntity form=new UserFormEntity();form.setDeleted(false);when(forms.getByKey("form1")).thenReturn(form);
+  UserFormVersionEntity v=new UserFormVersionEntity().setFormKey("form1").setVersionNo(1).setStatus(1);
+  Map<String,Object> field=new HashMap<>();field.put("formItemId","q1");field.put("type","TEXTAREA");field.put("label","食堂哪里需改善？");v.setItemsSnapshot(Collections.singletonList(field));when(versions.byNo("form1",1)).thenReturn(v);
+  doAnswer(a->{((Map<String,Object>)a.getArgument(0)).put("id",1L);return 1;}).when(db).createSource(anyMap());
+  AtomicReference<FollowUpDecision> record=new AtomicReference<>();doAnswer(a->{FollowUpDecision d=a.getArgument(0);d.setId(1L);record.set(d);return 1;}).when(db).insert(any(FollowUpDecision.class));when(db.selectById(1L)).thenAnswer(a->record.get());
+  Map<String,Object> status=new HashMap<>();status.put("provider","scripted fixture");status.put("model","fixture-no-model");when(llm.status()).thenReturn(status);
+  when(llm.decide(anyString(),anyString(),anyString())).thenReturn(new FollowUpDecisionProvider.Proposal("SKIP",reason,"","scripted fixture","fixture-no-model","constrained-llm-v1"));
+  FollowUpService service=new FollowUpService(db,forms,mock(UserFormItemService.class),versions,mock(UserFormSettingService.class),new RuleFollowUpProvider(),llm,tx);
+  FollowUpDecision result=service.decide(String.join("",Collections.nCopies(64,"a")),"q1","食堂不太方便");
+  assertEquals("SKIP",result.getAction());assertEquals(Integer.valueOf(2),result.getBudgetRemaining());verify(db,never()).charge(anyString());
+  verify(db).event(eq("session1"),eq(1L),eq(1L),anyString(),eq("NEXT_QUESTION"),anyString(),anyLong());
+  if(!consent)verify(llm,never()).decide(anyString(),anyString(),anyString());return result;
+ }
+ @Test public void timeoutRecordsTerminalStateWithoutBudgetCharge(){FollowUpDecision d=exercise("MODEL_FAILURE",true);assertEquals("TIMEOUT",d.getState());assertEquals("MODEL_FAILURE",d.getReasonCode());}
+ @Test public void malformedModelRecordsSkipWithoutBudgetCharge(){FollowUpDecision d=exercise("INVALID_MODEL_OUTPUT",true);assertEquals("SKIP",d.getState());assertEquals("INVALID_MODEL_OUTPUT",d.getReasonCode());}
+ @Test public void missingKeyRecordsSkipWithoutBudgetCharge(){assertEquals("NO_KEY",exercise("NO_KEY",true).getReasonCode());}
+ @Test public void declinedConsentDoesNotInvokeProvider(){assertEquals("NO_CONSENT",exercise("MODEL_FAILURE",false).getReasonCode());}
+}
