+package com.tduck.cloud.form.followup;
+
+import java.util.regex.*;
+import org.springframework.stereotype.Component;
+
+/** Explicit deterministic semantic categories. No answer-length threshold decision. */
+@Component
+public class RuleFollowUpProvider implements FollowUpDecisionProvider {
+    static Proposal result(String action,String reason,String quote) {
+        return new Proposal(action,reason,quote,"本地语义规则（非模型）","rule-followup-v1","constrained-rule-v1");
+    }
+    public Proposal decide(String goal,String question,String answer) {
+        String context=goal+question;
+        if(answer.matches("(?s).*(股票|炒股|比特币|世界杯|天气预报).*") && !context.matches("(?s).*(金融|投资|股票|体育|足球|天气).*"))
+            return result("SKIP","OFF_TOPIC","");
+        Matcher social=Pattern.compile("[^，。！？\\n]{0,12}(朋友|同学|室友|同伴|家人)[^，。！？\\n]{0,20}").matcher(answer);
+        if(social.find())return result("EXPLORE","SELF_RAISED_CUE",social.group().trim());
+        int detail=0;
+        if(Pattern.compile("[一二三四五六七八九十0-9]+(点|分钟|小时)|早上|晚上|中午").matcher(answer).find())detail++;
+        if(Pattern.compile("[一二三四五六七八九十0-9]+楼|窗口|门口|排队|路程").matcher(answer).find())detail++;
+        if(Pattern.compile("卖完|关门|没座|售罄|等了|迟到|找不到").matcher(answer).find())detail++;
+        if(detail>=2)return result("SKIP","CONCRETE_CONTEXT","");
+        if(Pattern.compile("不太方便|不方便|不太好|不满意|有问题|说不清|一般般|不合理|不舒服").matcher(answer).find())
+            return result("CLARIFY","AMBIGUOUS_EXPERIENCE",snippet(answer));
+        if(Pattern.compile("因为|导致|所以|影响|原因是").matcher(answer).find())
+            return result("DEEPEN","EXAMPLE_GAP",snippet(answer));
+        return result("SKIP","NO_CLEAR_INFORMATION_GAP","");
+    }
+    static String snippet(String text){return text.substring(0,Math.min(60,text.length())).replaceAll("[？?]","");}
+    public static String hardStop(String answer) {
+        if(Pattern.compile("1[3-9][0-9]{9}|[0-9]{17}[0-9Xx]|身份证|病历|确诊|诊断书|自杀|自残|住址是|电话号码").matcher(answer).find())return "PRIVACY_RISK";
+        if(Pattern.compile("不想说|不愿回答|拒绝回答|不方便透露|不想回答|不回答|保密").matcher(answer).find())return "RESPONDENT_DECLINED";
+        return null;
+    }
+    /** Quote must be a literal source span; prompts add no options or invented motivations. */
+    public static String neutralQuestion(Proposal p,String answer) {
+        if(!java.util.Arrays.asList("SKIP","CLARIFY","DEEPEN","EXPLORE").contains(p.action))throw new IllegalArgumentException("Invalid action");
+        if("SKIP".equals(p.action))return "";
+        if(p.quote==null||p.quote.trim().isEmpty()||p.quote.length()>150||!answer.contains(p.quote)||p.quote.matches("(?s).*[？?<>\\r\\n].*"))throw new IllegalArgumentException("Unverifiable quote");
+        if("EXPLORE".equals(p.action))return "关于你提到的“"+p.quote+"”，这如何影响你自己的选择？";
+        if("DEEPEN".equals(p.action))return "关于“"+p.quote+"”，你愿意举一个亲身经历的具体例子吗？";
+        return "你愿意说明一下“"+p.quote+"”具体指什么吗？";
+    }
+}
