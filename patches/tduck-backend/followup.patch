@@ -0,0 +1,45 @@
+package com.tduck.cloud.api.web.controller;
+
+import com.tduck.cloud.common.exception.BaseException;
+import com.tduck.cloud.common.util.Result;
+import com.tduck.cloud.form.followup.FollowUpService;
+import com.tduck.cloud.form.util.FormAuthUtils;
+import lombok.RequiredArgsConstructor;
+import org.springframework.web.bind.annotation.*;
+import javax.annotation.security.PermitAll;
+import javax.servlet.http.HttpServletRequest;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+
+@RestController
+@RequiredArgsConstructor
+public class FollowUpController {
+    private final FollowUpService service;
+    private final ConcurrentHashMap<String,AtomicInteger> rates=new ConcurrentHashMap<>();
+    private volatile long minute=System.currentTimeMillis()/60000;
+    private void limit(HttpServletRequest request,boolean create){
+        long now=System.currentTimeMillis()/60000;
+        if(now!=minute)synchronized(rates){if(now!=minute){rates.clear();minute=now;}}
+        String key=request.getRemoteAddr()+":"+create;
+        if(rates.size()>4096||rates.computeIfAbsent(key,k->new AtomicInteger()).incrementAndGet()>(create?30:200))throw new BaseException("追问请求过于频繁，请稍后重试；不影响普通答题提交");
+    }
+    @GetMapping("/user/form/followup/config")
+    public Result config(@RequestParam String formKey){FormAuthUtils.hasPermission(formKey);return Result.success(service.policy(formKey,0));}
+    @PostMapping("/user/form/followup/config")
+    public Result save(@RequestBody Map<String,Object> input){String key=String.valueOf(input.get("formKey"));FormAuthUtils.hasEditablePermission(key);return Result.success(service.savePolicy(key,input));}
+    @GetMapping("/user/form/followup/records")
+    public Result records(@RequestParam String formKey,@RequestParam int versionNo){FormAuthUtils.hasPermission(formKey);return Result.success(service.records(formKey,versionNo));}
+    @PermitAll @GetMapping("/form/followup/info")
+    public Result info(@RequestParam String formKey,@RequestParam(defaultValue="") String versionToken,HttpServletRequest r){limit(r,false);return Result.success(service.info(formKey,versionToken));}
+    @PermitAll @PostMapping("/form/followup/session")
+    public Result session(@RequestBody Map<String,Object> input,HttpServletRequest r){limit(r,true);return Result.success(service.create(input,r.getHeader("X-Form-Password"),r.getRemoteAddr()));}
+    @PermitAll @GetMapping("/form/followup/state")
+    public Result state(@RequestHeader("X-Followup-Session") String capability,HttpServletRequest r){limit(r,false);return Result.success(service.state(capability));}
+    @PermitAll @PostMapping("/form/followup/consent")
+    public Result consent(@RequestHeader("X-Followup-Session") String capability,@RequestBody Map<String,Object> input,HttpServletRequest r){limit(r,false);return Result.success(service.consent(capability,Boolean.TRUE.equals(input.get("consent"))));}
+    @PermitAll @PostMapping("/form/followup/decide")
+    public Result decide(@RequestHeader("X-Followup-Session") String capability,@RequestBody Map<String,Object> input,HttpServletRequest r){limit(r,false);Object answer=input.get("answer"),id=input.get("questionId");if(!(answer instanceof String)||!(id instanceof String))throw new BaseException("请提供开放题编号和文本答案");return Result.success(service.decide(capability,(String)id,(String)answer));}
+    @PermitAll @PostMapping("/form/followup/respond")
+    public Result respond(@RequestHeader("X-Followup-Session") String capability,@RequestBody Map<String,Object> input,HttpServletRequest r){limit(r,false);Object id=input.get("decisionId"),answer=input.get("answer");if(!(id instanceof Number)||(answer!=null&&!(answer instanceof String)))throw new BaseException("追问编号或回答格式不正确");return Result.success(service.respond(capability,((Number)id).longValue(),(String)answer,Boolean.TRUE.equals(input.get("skip"))));}
+}
