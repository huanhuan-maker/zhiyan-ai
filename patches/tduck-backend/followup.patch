+package com.tduck.cloud.api.ai;
+import com.tduck.cloud.form.followup.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class FollowUpPolicyTest {
+ private final RuleFollowUpProvider rule=new RuleFollowUpProvider();
+ @Test public void vagueMeansClarify(){assertEquals("CLARIFY",rule.decide("食堂改善","哪里需要改善","食堂不太方便").action);}
+ @Test public void concreteMeansSkip(){assertEquals("SKIP",rule.decide("食堂改善","哪里需要改善","六点二楼排队十五分钟，轮到我时菜卖完了").action);}
+ @Test public void selfRaisedCueMeansExplore(){FollowUpDecisionProvider.Proposal p=rule.decide("图书馆使用原因","为什么不去图书馆","我朋友都不去，所以我也没动力去");assertEquals("EXPLORE",p.action);assertTrue("我朋友都不去，所以我也没动力去".contains(p.quote));}
+ @Test public void repetitiveLongVagueStillClarifies(){assertEquals("CLARIFY",rule.decide("食堂","改善","食堂不太方便，真的不太方便，说不清，就是不方便，一直觉得不太方便").action);}
+ @Test public void shortSpecificIsNotForcedToAsk(){assertEquals("SKIP",rule.decide("食堂","改善","六点排队卖完").action);}
+ @Test public void causalGapCanDeepen(){assertEquals("DEEPEN",rule.decide("食堂","改善","因为课程安排所以吃饭受影响").action);}
+ @Test public void noGapMeansSkip(){assertEquals("SKIP",rule.decide("食堂","改善","挺好的").action);}
+ @Test public void unrelatedTopicStops(){assertEquals("OFF_TOPIC",rule.decide("食堂","改善","最近比特币上涨").reason);}
+ @Test public void refusalStopsBeforeProvider(){assertEquals("RESPONDENT_DECLINED",RuleFollowUpProvider.hardStop("不想回答这个问题"));}
+ @Test public void privacyStopsBeforeProvider(){assertEquals("PRIVACY_RISK",RuleFollowUpProvider.hardStop("我的身份证需要保密"));}
+ @Test public void promptHasOneQuestionAndNoInventedOptions(){FollowUpDecisionProvider.Proposal p=rule.decide("食堂","改善","食堂不太方便");String q=RuleFollowUpProvider.neutralQuestion(p,"食堂不太方便");assertFalse(q.contains("卫生"));assertEquals(1,q.chars().filter(c->c=='？').count());}
+ @Test(expected=IllegalArgumentException.class) public void fabricatedQuoteRejected(){RuleFollowUpProvider.neutralQuestion(new FollowUpDecisionProvider.Proposal("EXPLORE","x","虚构证据","x","x","x"),"食堂不方便");}
+ @Test(expected=IllegalArgumentException.class) public void multipleQuestionQuoteRejected(){RuleFollowUpProvider.neutralQuestion(new FollowUpDecisionProvider.Proposal("CLARIFY","x","为什么？","x","x","x"),"为什么？");}
+ @Test public void noKeyDegradesClearly(){FollowUpDecisionProvider.Proposal p=new LlmFollowUpProvider("test","","","",500).decide("食堂","改善","不方便");assertEquals("SKIP",p.action);assertEquals("NO_KEY",p.reason);}
+}
