+package com.tduck.cloud.form.ai;
+
+import cn.hutool.core.util.StrUtil;
+import cn.hutool.http.HttpRequest;
+import cn.hutool.http.HttpResponse;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * OpenAI 兼容 Chat Completions Provider（配置于服务端私有 application-local.yml）。
+ * 无密钥/超时/网络失败/非 200 均抛出可恢复异常，不阻塞普通问卷功能。
+ */
+@Slf4j
+@Component
+public class OpenAiCompatibleProvider implements AiProvider {
+
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+
+    private final String providerName;
+    private final String baseUrl;
+    private final String apiKey;
+    private final String model;
+    private final int timeoutMs;
+
+    public OpenAiCompatibleProvider(
+            @Value("${ai.provider-name:OpenAI Compatible}") String providerName,
+            @Value("${ai.base-url:}") String baseUrl,
+            @Value("${ai.api-key:}") String apiKey,
+            @Value("${ai.model:}") String model,
+            @Value("${ai.timeout-ms:60000}") int timeoutMs) {
+        this.providerName = providerName;
+        this.baseUrl = baseUrl == null ? "" : baseUrl.trim();
+        this.apiKey = apiKey == null ? "" : apiKey.trim();
+        this.model = model == null ? "" : model.trim();
+        this.timeoutMs = timeoutMs <= 0 ? 60000 : timeoutMs;
+    }
+
+    @Override
+    public boolean available() {
+        return StrUtil.isNotBlank(baseUrl) && StrUtil.isNotBlank(apiKey) && StrUtil.isNotBlank(model);
+    }
+
+    @Override
+    public String providerName() {
+        return providerName;
+    }
+
+    @Override
+    public String model() {
+        return model;
+    }
+
+    @Override
+    public String complete(String systemPrompt, String inputJson) {
+        if (!available()) {
+            throw new AiProviderException("AI 服务未配置（缺少 base-url/api-key/model），当前为 Mock 模式");
+        }
+        Map<String, Object> body = new HashMap<>();
+        body.put("model", model);
+        body.put("messages", Arrays.asList(
+                message("system", systemPrompt),
+                message("user", inputJson)));
+        body.put("temperature", 0.3);
+        String payload;
+        try {
+            payload = MAPPER.writeValueAsString(body);
+        } catch (Exception e) {
+            throw new AiProviderException("AI 请求组装失败，请重试", e);
+        }
+        String responseText;
+        try (HttpResponse response = HttpRequest.post(trimTrailingSlash(baseUrl) + "/chat/completions")
+                .header("Authorization", "Bearer " + apiKey)
+                .header("Content-Type", "application/json;charset=UTF-8")
+                .body(payload)
+                .timeout(timeoutMs)
+                .execute()) {
+            if (response.getStatus() != 200) {
+                // 只记录状态码与截断片段，绝不记录鉴权头或密钥
+                log.warn("AI provider http status {}, body head: {}", response.getStatus(), StrUtil.maxLength(response.body(), 200));
+                throw new AiProviderException("AI 服务返回异常（HTTP " + response.getStatus() + "），请稍后重试或改用手工建卷");
+            }
+            responseText = response.body();
+        } catch (AiProviderException e) {
+            throw e;
+        } catch (Exception e) {
+            log.warn("AI provider request failed: {}", e.getMessage());
+            throw new AiProviderException("AI 服务请求失败（超时或网络异常），可稍后重试；手工建卷不受影响", e);
+        }
+        try {
+            JsonNode content = MAPPER.readTree(responseText).path("choices").path(0).path("message").path("content");
+            if (content.isMissingNode() || content.asText().trim().isEmpty()) {
+                throw new AiProviderException("AI 服务返回内容为空，请重试");
+            }
+            return content.asText();
+        } catch (AiProviderException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new AiProviderException("AI 服务响应无法解析，请重试", e);
+        }
+    }
+
+    private static Map<String, String> message(String role, String content) {
+        Map<String, String> m = new HashMap<>();
+        m.put("role", role);
+        m.put("content", content);
+        return m;
+    }
+
+    private static String trimTrailingSlash(String url) {
+        return url.endsWith("/") ? url.substring(0, url.length() - 1) : url;
+    }
+}

