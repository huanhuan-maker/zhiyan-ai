+package com.tduck.cloud.form.ai;
+
+/**
+ * M2 问卷草稿 AI Provider 抽象。Provider 仅由 Spring Boot 服务端统一调用，
+ * API Key 只存在于服务端私有配置，不进入前端、日志或数据库。
+ */
+public interface AiProvider {
+
+    /** 配置是否可用（决定页面展示"真实 AI"还是降级 Mock） */
+    boolean available();
+
+    /** 展示名（Provider 标识，不含任何密钥） */
+    String providerName();
+
+    /** 模型标识 */
+    String model();
+
+    /**
+     * 完成一次草稿生成。输入为结构化 JSON 字符串，期望返回纯 JSON 文本。
+     * 失败抛出面向用户的 {@link AiProviderException}。
+     */
+    String complete(String systemPrompt, String inputJson) throws AiProviderException;
+}

