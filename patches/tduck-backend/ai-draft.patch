+package com.tduck.cloud.form.ai;
+
+/**
+ * AI 服务调用异常。消息面向用户、可恢复：调用方可提示重试或改用手工建卷，
+ * 不携带 API Key、内部 URL 细节或堆栈信息。
+ */
+public class AiProviderException extends RuntimeException {
+
+    public AiProviderException(String userMessage) {
+        super(userMessage);
+    }
+
+    public AiProviderException(String userMessage, Throwable cause) {
+        super(userMessage, cause);
+    }
+}

