+package com.tduck.cloud.form.ai;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.springframework.stereotype.Component;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 无密钥时的降级 Provider：按输入确定性生成草稿，页面与响应中明确标注 Mock。
+ * 输出与真实 Provider 同构，仍需通过 AiDraftValidator 全量校验。
+ */
+@Component
+public class MockAiProvider implements AiProvider {
+
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+
+    @Override
+    public boolean available() {
+        return true;
+    }
+
+    @Override
+    public String providerName() {
+        return "Mock（未配置真实 AI）";
+    }
+
+    @Override
+    public String model() {
+        return "mock-template";
+    }
+
+    @Override
+    public String complete(String systemPrompt, String inputJson) {
+        try {
+            Map<?, ?> input = MAPPER.readValue(inputJson, Map.class);
+            String goal = String.valueOf(input.get("goal"));
+            String audience = String.valueOf(input.get("audience"));
+            int count = ((Number) input.get("questionCount")).intValue();
+            String trimmedGoal = goal.length() > 18 ? goal.substring(0, 18) : goal;
+            Map<String, Object> spec = new LinkedHashMap<>();
+            spec.put("kind", "draft");
+            spec.put("title", "（Mock）" + trimmedGoal + "调查");
+            spec.put("description", "本问卷由 Mock 模式生成，仅用于流程验证；内容未经过真实 AI。目标人群：" + audience + "。");
+            List<Map<String, Object>> questions = new ArrayList<>();
+            String[] cycle = {"RADIO", "CHECKBOX", "RATE", "TEXT"};
+            for (int i = 0; i < count; i++) {
+                String type = cycle[i % cycle.length];
+                int no = i + 1;
+                Map<String, Object> q = new LinkedHashMap<>();
+                q.put("type", type);
+                q.put("required", type.equals("TEXT") ? Boolean.FALSE : Boolean.TRUE);
+                if ("RADIO".equals(type)) {
+                    q.put("label", "（Mock·" + no + "）您认为" + audience + "不参与「" + trimmedGoal + "」的最主要原因是？");
+                    q.put("options", List.of("不了解信息", "时间冲突", "兴趣不足", "其他"));
+                } else if ("CHECKBOX".equals(type)) {
+                    q.put("label", "（Mock·" + no + "）以下哪些因素会影响" + audience + "参与「" + trimmedGoal + "」？（可多选）");
+                    q.put("options", List.of("时间安排", "费用成本", "同伴参与", "宣传渠道"));
+                } else if ("RATE".equals(type)) {
+                    q.put("label", "（Mock·" + no + "）您对「" + trimmedGoal + "」相关安排的整体满意度评分");
+                    q.put("rateMax", 5);
+                } else {
+                    q.put("label", "（Mock·" + no + "）关于「" + trimmedGoal + "」，您还有什么想补充的？");
+                }
+                questions.add(q);
+            }
+            // 保证至少一道开放题（题数少于 4 时循环可能未覆盖 TEXT）
+            if (questions.stream().noneMatch(q -> "TEXT".equals(q.get("type")))) {
+                Map<String, Object> last = questions.get(questions.size() - 1);
+                last.put("type", "TEXT");
+                last.remove("options");
+                last.remove("rateMax");
+                last.put("label", "（Mock·" + count + "）关于「" + trimmedGoal + "」，您还有什么想补充的？");
+                last.put("required", Boolean.FALSE);
+            }
+            spec.put("questions", questions);
+            spec.put("assumptions", List.of("Mock 模式：未调用真实模型，假设仅供占位"));
+            spec.put("dimensions", List.of("参与障碍", "满意度", "开放补充"));
+            return MAPPER.writeValueAsString(spec);
+        } catch (Exception e) {
+            throw new AiProviderException("Mock 生成失败：" + e.getMessage(), e);
+        }
+    }
+}

