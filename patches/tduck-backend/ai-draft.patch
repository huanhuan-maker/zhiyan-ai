+package com.tduck.cloud.form.ai;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * AI 草稿服务端校验器（纯函数，可单测）。
+ * 任何 error 级违规的草稿都不允许进入编辑器/保存/发布路径；
+ * warning 级提示仅展示给发起者人工审核。
+ */
+public final class AiDraftValidator {
+
+    public static final int MAX_QUESTIONS = 30;
+    public static final int MIN_OPTIONS = 2;
+    public static final int MAX_OPTIONS = 20;
+    public static final int MIN_RATE_MAX = 2;
+    public static final int MAX_RATE_MAX = 10;
+    public static final int DEFAULT_RATE_MAX = 5;
+
+    /** 诱导性措辞黑名单（warning 级，供人工审核） */
+    private static final String[] LEADING_WORDS = {"难道", "难道说", "显然", "当然不", "肯定不", "不觉得", "大家都认为"};
+
+    private AiDraftValidator() {
+    }
+
+    /** 支持的题型（编辑器四题型） */
+    static String normalizeType(String raw) {
+        if (raw == null) {
+            return null;
+        }
+        switch (raw.trim().toUpperCase()) {
+            case "RADIO":
+            case "CHECKBOX":
+            case "RATE":
+                return raw.trim().toUpperCase();
+            case "TEXT":
+            case "TEXTAREA":
+            case "INPUT":
+            case "OPEN":
+                return "TEXTAREA";
+            default:
+                return null;
+        }
+    }
+
+    public static Result validate(AiDraftSpec spec, int expectedCount) {
+        Result result = new Result();
+        if (spec == null || spec.getKind() == null || spec.getKind().trim().isEmpty()) {
+            result.errors.add("输出缺少 kind 字段");
+            return result;
+        }
+        String kind = spec.getKind().trim().toLowerCase();
+        if ("clarification".equals(kind)) {
+            validateClarification(spec, result);
+            return result;
+        }
+        if (!"draft".equals(kind)) {
+            result.errors.add("kind 必须是 draft 或 clarification，实际为 " + spec.getKind());
+            return result;
+        }
+        validateDraft(spec, expectedCount, result);
+        return result;
+    }
+
+    private static void validateClarification(AiDraftSpec spec, Result result) {
+        List<String> questions = spec.getClarification();
+        if (questions == null || questions.isEmpty()) {
+            result.errors.add("澄清模式缺少 clarification 问题列表");
+            return;
+        }
+        for (String q : questions) {
+            if (q == null || q.trim().isEmpty()) {
+                result.errors.add("澄清问题不能为空");
+            }
+        }
+    }
+
+    private static void validateDraft(AiDraftSpec spec, int expectedCount, Result result) {
+        if (isBlank(spec.getTitle())) {
+            result.errors.add("问卷标题不能为空");
+        } else if (spec.getTitle().trim().length() > 100) {
+            result.errors.add("问卷标题超过 100 字");
+        }
+        List<AiDraftSpec.AiDraftQuestion> questions = spec.getQuestions();
+        if (questions == null || questions.isEmpty()) {
+            result.errors.add("草稿缺少题目列表");
+            return;
+        }
+        if (questions.size() != expectedCount) {
+            result.errors.add("题数 " + questions.size() + " 与期望题数 " + expectedCount + " 不符");
+        }
+        if (questions.size() > MAX_QUESTIONS) {
+            result.errors.add("题目数量超过上限 " + MAX_QUESTIONS);
+        }
+        Set<String> seenLabels = new HashSet<>();
+        int openCount = 0;
+        for (int i = 0; i < questions.size(); i++) {
+            AiDraftSpec.AiDraftQuestion q = questions.get(i);
+            String at = "第 " + (i + 1) + " 题";
+            String type = normalizeType(q.getType());
+            if (type == null) {
+                result.errors.add(at + "题型 " + q.getType() + " 不在支持范围（RADIO/CHECKBOX/RATE/TEXT）");
+                continue;
+            }
+            if (isBlank(q.getLabel())) {
+                result.errors.add(at + "题干为空");
+                continue;
+            }
+            if (q.getLabel().trim().length() > 200) {
+                result.errors.add(at + "题干超过 200 字");
+            }
+            String labelKey = q.getLabel().trim();
+            if (!seenLabels.add(labelKey)) {
+                result.errors.add(at + "题干与其他题目重复");
+            }
+            if (containsLeadingWord(labelKey)) {
+                result.warnings.add(at + "题干可能含诱导性措辞，请人工确认");
+            }
+            Map<String, Object> normalized = new LinkedHashMap<>();
+            normalized.put("type", type);
+            normalized.put("label", labelKey);
+            normalized.put("required", q.getRequired() == null ? Boolean.TRUE : q.getRequired());
+            if ("RADIO".equals(type) || "CHECKBOX".equals(type)) {
+                List<String> options = q.getOptions();
+                if (options == null || options.size() < MIN_OPTIONS) {
+                    result.errors.add(at + "选项数量不足（至少 " + MIN_OPTIONS + " 个）");
+                } else if (options.size() > MAX_OPTIONS) {
+                    result.errors.add(at + "选项数量超过上限 " + MAX_OPTIONS);
+                } else {
+                    Set<String> seen = new HashSet<>();
+                    for (String option : options) {
+                        if (isBlank(option)) {
+                            result.errors.add(at + "存在空选项");
+                        } else if (!seen.add(option.trim())) {
+                            result.errors.add(at + "选项「" + option.trim() + "」重复");
+                        }
+                        if (containsLeadingWord(option)) {
+                            result.warnings.add(at + "选项「" + trim(option) + "」可能含诱导性措辞，请人工确认");
+                        }
+                    }
+                    if (options.size() == MIN_OPTIONS) {
+                        result.warnings.add(at + "仅有 2 个选项，覆盖面可能不足");
+                    }
+                }
+                normalized.put("options", options);
+            } else if ("RATE".equals(type)) {
+                Integer max = q.getRateMax();
+                if (max == null) {
+                    max = DEFAULT_RATE_MAX;
+                } else if (max < MIN_RATE_MAX || max > MAX_RATE_MAX) {
+                    result.errors.add(at + "量表范围 rateMax=" + max + " 超出 " + MIN_RATE_MAX + "-" + MAX_RATE_MAX);
+                    max = null;
+                }
+                normalized.put("rateMax", max);
+            } else {
+                openCount++;
+                normalized.put("placeholder", trim(q.getPlaceholder()));
+            }
+            result.questions.add(normalized);
+        }
+        if (openCount == 0 && result.errors.isEmpty()) {
+            result.errors.add("草稿缺少开放题（至少 1 道 TEXT）");
+        }
+    }
+
+    private static boolean isBlank(String value) {
+        return value == null || value.trim().isEmpty();
+    }
+
+    private static String trim(String value) {
+        return value == null ? "" : value.trim();
+    }
+
+    private static boolean containsLeadingWord(String text) {
+        if (text == null) {
+            return false;
+        }
+        for (String word : LEADING_WORDS) {
+            if (text.contains(word)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** 校验结果：errors 非空即拒绝；questions 为归一化后的题目（编辑器四题型） */
+    public static class Result {
+        public final List<String> errors = new ArrayList<>();
+        public final List<String> warnings = new ArrayList<>();
+        public final List<Map<String, Object>> questions = new ArrayList<>();
+    }
+}

