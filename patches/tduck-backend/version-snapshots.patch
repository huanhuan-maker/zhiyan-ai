@@ -0,0 +1,347 @@
+package com.tduck.cloud.form.service;
+
+import com.baomidou.mybatisplus.core.toolkit.Wrappers;
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.tduck.cloud.form.entity.UserFormEntity;
+import com.tduck.cloud.form.entity.UserFormItemEntity;
+import com.tduck.cloud.form.entity.UserFormLogicEntity;
+import com.tduck.cloud.form.entity.UserFormThemeEntity;
+import com.tduck.cloud.form.entity.UserFormVersionEntity;
+import com.tduck.cloud.form.entity.enums.FormItemTypeEnum;
+import com.tduck.cloud.form.entity.enums.FormTypeEnum;
+import com.tduck.cloud.form.mapper.UserFormVersionMapper;
+import com.tduck.cloud.form.vo.FormFieldVO;
+import com.tduck.cloud.form.vo.UserFormDetailVO;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * 问卷发布版本快照服务。
+ * 发布时冻结题目集为不可变版本；答卷按版本号绑定；
+ * 停止收集后可修改草稿，重新发布生成新版本并关闭旧版本。
+ */
+@Service
+@RequiredArgsConstructor
+public class UserFormVersionService {
+    private static final SecureRandom RANDOM = new SecureRandom();
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+    private static final char[] TOKEN_ALPHABET =
+            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".toCharArray();
+
+    private final UserFormVersionMapper versions;
+    private final UserFormItemService formItems;
+    private final UserFormService forms;
+    private final UserFormLogicService logics;
+    private final UserFormThemeService themes;
+
+    /**
+     * 发布快照：关闭当前收集中版本，按当前题目集生成新版本（事务内）。
+     */
+    @Transactional(rollbackFor = Exception.class)
+    public UserFormVersionEntity publishSnapshot(String formKey) {
+        versions.update(null, Wrappers.<UserFormVersionEntity>lambdaUpdate()
+                .eq(UserFormVersionEntity::getFormKey, formKey)
+                .eq(UserFormVersionEntity::getStatus, UserFormVersionEntity.STATUS_OPEN)
+                .set(UserFormVersionEntity::getStatus, UserFormVersionEntity.STATUS_CLOSED));
+        List<UserFormVersionEntity> existing = versions.selectList(Wrappers.<UserFormVersionEntity>lambdaQuery()
+                .eq(UserFormVersionEntity::getFormKey, formKey)
+                .orderByDesc(UserFormVersionEntity::getVersionNo));
+        int nextNo = existing.isEmpty() ? 1 : existing.get(0).getVersionNo() + 1;
+        List<UserFormItemEntity> items = formItems.list(Wrappers.<UserFormItemEntity>lambdaQuery()
+                .eq(UserFormItemEntity::getFormKey, formKey));
+        items.sort(Comparator.comparing(item -> item.getSort() == null ? 0L : item.getSort()));
+        List<Map<String, Object>> snapshot = new ArrayList<>();
+        for (UserFormItemEntity item : items) {
+            snapshot.add(snapshotOf(item));
+        }
+        if (snapshot.isEmpty()) {
+            throw new IllegalStateException("没有可发布的题目");
+        }
+        UserFormEntity form = forms.getByKey(formKey);
+        Map<String, Object> formSnapshot = new LinkedHashMap<>();
+        if (form != null) {
+            formSnapshot.put("name", form.getName());
+            formSnapshot.put("description", form.getDescription());
+            formSnapshot.put("type", form.getType() == null ? null : form.getType().name());
+        }
+        UserFormLogicEntity logic = logics.getOne(Wrappers.<UserFormLogicEntity>lambdaQuery()
+                .eq(UserFormLogicEntity::getFormKey, formKey));
+        // 空集合哨兵：区分"发布时无逻辑/主题"（还原为无）与"历史版本无快照"（回退当前值）
+        List<Map<String, Object>> logicSnapshot = new ArrayList<>();
+        if (logic != null && logic.getScheme() != null && !logic.getScheme().isEmpty()) {
+            logicSnapshot = MAPPER.convertValue(logic.getScheme(), new TypeReference<List<Map<String, Object>>>() {});
+        }
+        UserFormThemeEntity theme = themes.getByKey(formKey);
+        UserFormVersionEntity version = new UserFormVersionEntity()
+                .setFormKey(formKey)
+                .setVersionNo(nextNo)
+                .setStatus(UserFormVersionEntity.STATUS_OPEN)
+                .setShareToken(newToken())
+                .setItemsSnapshot(snapshot)
+                .setFormSnapshot(formSnapshot)
+                .setLogicSnapshot(logicSnapshot)
+                .setThemeSnapshot(theme == null ? new LinkedHashMap<>() : themeOf(theme));
+        versions.insert(version);
+        return version;
+    }
+
+    /** 主题快照只取业务字段，不含主键与时间戳 */
+    private static Map<String, Object> themeOf(UserFormThemeEntity theme) {
+        if (theme == null) {
+            return null;
+        }
+        Map<String, Object> map = new LinkedHashMap<>();
+        map.put("logoImg", theme.getLogoImg());
+        map.put("logoPosition", theme.getLogoPosition());
+        map.put("headImgUrl", theme.getHeadImgUrl());
+        map.put("themeColor", theme.getThemeColor());
+        map.put("submitBtnText", theme.getSubmitBtnText());
+        map.put("backgroundColor", theme.getBackgroundColor());
+        map.put("backgroundImg", theme.getBackgroundImg());
+        map.put("showTitle", theme.getShowTitle());
+        map.put("showDescribe", theme.getShowDescribe());
+        map.put("showNumber", theme.getShowNumber());
+        map.put("showSubmitBtn", theme.getShowSubmitBtn());
+        return map;
+    }
+
+    public UserFormVersionEntity byToken(String token) {
+        if (token == null || token.trim().isEmpty()) {
+            return null;
+        }
+        return versions.selectOne(Wrappers.<UserFormVersionEntity>lambdaQuery()
+                .eq(UserFormVersionEntity::getShareToken, token.trim()));
+    }
+
+    public UserFormVersionEntity byNo(String formKey, Integer versionNo) {
+        if (formKey == null || versionNo == null) {
+            return null;
+        }
+        return versions.selectOne(Wrappers.<UserFormVersionEntity>lambdaQuery()
+                .eq(UserFormVersionEntity::getFormKey, formKey)
+                .eq(UserFormVersionEntity::getVersionNo, versionNo));
+    }
+
+    /** 最新版本（含已停止），无版本返回 null（草稿/兼容路径） */
+    public UserFormVersionEntity latest(String formKey) {
+        List<UserFormVersionEntity> list = versions.selectList(Wrappers.<UserFormVersionEntity>lambdaQuery()
+                .eq(UserFormVersionEntity::getFormKey, formKey)
+                .orderByDesc(UserFormVersionEntity::getVersionNo)
+                .last("limit 1"));
+        return list.isEmpty() ? null : list.get(0);
+    }
+
+    /** 当前收集中的版本，无则返回 null */
+    public UserFormVersionEntity openVersion(String formKey) {
+        List<UserFormVersionEntity> list = versions.selectList(Wrappers.<UserFormVersionEntity>lambdaQuery()
+                .eq(UserFormVersionEntity::getFormKey, formKey)
+                .eq(UserFormVersionEntity::getStatus, UserFormVersionEntity.STATUS_OPEN)
+                .orderByDesc(UserFormVersionEntity::getVersionNo)
+                .last("limit 1"));
+        return list.isEmpty() ? null : list.get(0);
+    }
+
+    @Transactional(rollbackFor = Exception.class)
+    public void closeOpen(String formKey) {
+        versions.update(null, Wrappers.<UserFormVersionEntity>lambdaUpdate()
+                .eq(UserFormVersionEntity::getFormKey, formKey)
+                .eq(UserFormVersionEntity::getStatus, UserFormVersionEntity.STATUS_OPEN)
+                .set(UserFormVersionEntity::getStatus, UserFormVersionEntity.STATUS_CLOSED));
+    }
+
+    public List<UserFormVersionEntity> listByForm(String formKey) {
+        return versions.selectList(Wrappers.<UserFormVersionEntity>lambdaQuery()
+                .eq(UserFormVersionEntity::getFormKey, formKey)
+                .orderByDesc(UserFormVersionEntity::getVersionNo));
+    }
+
+    /** 从快照重建题目列表（隐藏题在返回时过滤，快照本体保持完整） */
+    public List<UserFormItemEntity> itemsOf(UserFormVersionEntity version) {
+        List<UserFormItemEntity> items = new ArrayList<>();
+        if (version == null || version.getItemsSnapshot() == null) {
+            return items;
+        }
+        for (Map<String, Object> raw : version.getItemsSnapshot()) {
+            if (raw == null) {
+                continue;
+            }
+            UserFormItemEntity item = new UserFormItemEntity();
+            item.setId(longOf(raw.get("id")));
+            item.setFormKey(strOf(raw.get("formKey")));
+            item.setFormItemId(strOf(raw.get("formItemId")));
+            String type = strOf(raw.get("type"));
+            if (type != null && !type.isEmpty()) {
+                try {
+                    item.setType(FormItemTypeEnum.valueOf(type));
+                } catch (IllegalArgumentException ignored) {
+                }
+            }
+            item.setLabel(strOf(raw.get("label")));
+            item.setDisplayType(boolOf(raw.get("displayType")));
+            item.setHideType(boolOf(raw.get("hideType")));
+            item.setSpecialType(boolOf(raw.get("specialType")));
+            item.setShowLabel(boolOf(raw.get("showLabel")));
+            item.setDefaultValue(strOf(raw.get("defaultValue")));
+            item.setRequired(boolOf(raw.get("required")));
+            item.setPlaceholder(strOf(raw.get("placeholder")));
+            item.setSort(longOf(raw.get("sort")));
+            item.setSpan(raw.get("span") instanceof Number ? ((Number) raw.get("span")).intValue() : 24);
+            item.setScheme(mapOf(raw.get("scheme")));
+            item.setRegList(listOfMaps(raw.get("regList")));
+            if (Boolean.TRUE.equals(item.getHideType())) {
+                continue;
+            }
