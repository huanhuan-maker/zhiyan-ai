+package com.tduck.cloud.form.service;
+
+import cn.hutool.crypto.digest.DigestUtil;
+import com.tduck.cloud.common.util.Result;
+import com.tduck.cloud.form.entity.UserFormDataEntity;
+import com.tduck.cloud.form.mapper.PublicSubmissionMapper;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import java.util.HashMap;
+import java.util.Map;
+
+@Service
+@RequiredArgsConstructor
+public class PublicSubmissionService {
+    private final PublicSubmissionMapper submissions;
+    private final UserFormDataService answers;
+    private final UserFormSettingService settings;
+
+    @Transactional(rollbackFor = Exception.class)
+    public Map<String,Object> submit(UserFormDataEntity entity, String session) {
+        if(session == null || !session.matches("[a-zA-Z0-9-]{32,80}"))
+            throw new IllegalArgumentException("缺少有效答题会话，请刷新页面后重试");
+        String hash = DigestUtil.sha256Hex(session);
+        submissions.reserve(entity.getFormKey(), hash);
+        Long existing = submissions.answer(entity.getFormKey(), hash);
+        if(existing != null) {
+            Map<String,Object> result = new HashMap<>();
+            result.put("id", existing);
+            result.put("replayed", true);
+            return result;
+        }
+        Result<Boolean> status = settings.getUserFormWriteSettingStatus(entity.getFormKey(),entity.getSubmitRequestIp(),entity.getWxOpenId(),1);
+        if(status.getMsg()!=null && !status.getMsg().isEmpty()) throw new IllegalArgumentException(status.getMsg());
+        // Generated IDs only. A public client must not choose an existing answer ID.
+        entity.setId(null);
+        Map<String,Object> result = answers.saveFormResult(entity);
+        submissions.complete(entity.getFormKey(),hash,entity.getId());
+        result.put("replayed",false);
+        return result;
+    }
+}
