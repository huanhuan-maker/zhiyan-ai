+package com.tduck.cloud.form.mapper;
+
+import org.apache.ibatis.annotations.*;
+
+public interface PublicSubmissionMapper {
+    @Insert("INSERT INTO fm_public_submission(form_key, session_hash) VALUES(#{key}, #{hash}) ON DUPLICATE KEY UPDATE session_hash=VALUES(session_hash)")
+    int reserve(@Param("key") String key, @Param("hash") String hash);
+
+    @Select("SELECT answer_id FROM fm_public_submission WHERE form_key=#{key} AND session_hash=#{hash} FOR UPDATE")
+    Long answer(@Param("key") String key, @Param("hash") String hash);
+
+    @Update("UPDATE fm_public_submission SET answer_id=#{answer} WHERE form_key=#{key} AND session_hash=#{hash}")
+    int complete(@Param("key") String key, @Param("hash") String hash, @Param("answer") Long answer);
+}
